# Copy to .env and fill in. .env is gitignored.

# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (formerly Polygon.io) API key for real market data.
# If not set, the built-in market simulator is used (recommended for most users).
# The key's plan must include stock snapshots.
MASSIVE_API_KEY=

# Optional: seconds between Massive polls (default 15, the free tier's 5 req/min).
# Paid plans can use 2-5.
MASSIVE_POLL_INTERVAL=

# Optional: set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false
